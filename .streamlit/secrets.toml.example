# Example Streamlit secrets. On Streamlit Community Cloud, do NOT commit a real
# secrets.toml — instead paste these keys into the app's "Secrets" section in the
# Cloud dashboard (App > Settings > Secrets). For local dev you can copy this file
# to .streamlit/secrets.toml (which is gitignored).

# Public URL of the deployed FastAPI backend (Render/Railway/Fly).
# Leave unset locally to default to http://localhost:8000.
BACKEND_URL = "https://your-backend.onrender.com"
